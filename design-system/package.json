{
  "name": "@moona/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Moona Studio design system — void/ice/gold tokens and the React components behind moona-studio-site.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./styles.css": "./src/styles/components.css"
  },
  "sideEffects": ["*.css"],
  "scripts": {
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  },
  "keywords": ["design-system", "tokens", "moona"]
}
